@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bank Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-circle">P</div>
            <span class="logo-text">Pro.Net</span>
        </div>

        <nav class="sidebar-nav">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link-custom">
                <i class="fas fa-home"></i> <span>Dashboard</span>
            </a>

            <a asp-area="" asp-controller="Clients" asp-action="AddNewClient" class="nav-link-custom">
                <i class="fas fa-user-plus"></i> <span>Add New Client</span>
            </a>

            <a asp-area="" asp-controller="Loans" asp-action="Index" class="nav-link-custom">
                <i class="fas fa-hand-holding-usd"></i> <span>Credit Accounts</span>
            </a>

            <a asp-page="/Corporate/Index" class="nav-link-custom">
                <i class="fas fa-briefcase"></i> <span>Corporate Loans</span>
            </a>

            @* Reports section visible only to Admin *@
            @{
                var userRole = Context.Session.GetString("DemoRole") ?? "Admin";
            }

            @if (userRole == "Admin")
            {
                <div class="sidebar-divider"></div>
                <div class="ps-3 small text-uppercase text-muted mb-2" style="font-size: 0.7rem; letter-spacing: 1px;">Reports</div>
                <div class="ps-3 small text-uppercase text-muted mb-2" style="font-size: 0.7rem;">Analytics</div>

                <a asp-page="/Transactions/TransactionsList" class="nav-link-custom">
                    <i class="fas fa-file-invoice"></i> <span>Withdrawal List</span>
                </a>
                <a asp-page="/Reports/Analytics" class="nav-link-custom text-warning">
                    <i class="fas fa-chart-line"></i> <span>Analytical report</span>
                </a>
            }

            <div class="sidebar-divider"></div>
        </nav>
    </div>

    <div class="main-content" id="main-content">
        <header class="top-bar d-flex justify-content-between align-items-center px-3">
            <div>
                <i class="fas fa-bars" id="sidebarCollapse" style="cursor: pointer; margin-right: 10px;"></i> Loan Management System
            </div>

            <div class="d-flex align-items-center">
                <form method="post" asp-page-handler="ChangeRole" class="me-3">
                    <select name="selectedRole" onchange="this.form.submit()" class="form-select form-select-sm border-warning">
                        @{
                            var currentRole = Context.Session.GetString("DemoRole") ?? "Admin";
                        }
                        <!option value="Admin" @(currentRole == "Admin" ? "selected" : "")>👑 Admin</!option>
                        <!option value="Manager" @(currentRole == "Manager" ? "selected" : "")>💼 Manager</!option>
                        <!option value="Guest" @(currentRole == "Guest" ? "selected" : "")>👤 Guest</!option>
                    </select>
                </form>
            </div>

        </header>
        <main role="main" class="container-fluid p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>