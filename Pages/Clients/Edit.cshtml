@page "{id:int}"
@model LoanManagementSystem.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Edit Client";
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Clients/AddNewClient">Clients List</a></li>
            <li class="breadcrumb-item active">Edit Client</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Edit Client Details</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="ClientData.Id" />

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="ClientData.Name" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Position</label>
                            <input asp-for="ClientData.Position" class="form-control" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Office</label>
                                <input asp-for="ClientData.Office" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Age</label>
                                <input asp-for="ClientData.Age" type="number" class="form-control" />
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-page="/Clients/AddNewClient" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>