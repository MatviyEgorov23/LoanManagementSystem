@page
@model LoanManagementSystem.Pages.Corporate.CreateModel
@{
    ViewData["Title"] = "New Corporate Application";
}

<div class="container-fluid">
    <form method="post">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-building text-primary me-2"></i>Corporate Loan Registration</h2>
            <div>
                <a asp-page="/Corporate/Index" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-warning px-4">Save Application</button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light fw-bold">General Information</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Company Name</label>
                            <input asp-for="Company.CompanyName" class="form-control" required />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Industry</label>
                                <input asp-for="Company.Industry" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Reg. Number (ID)</label>
                                <input asp-for="Company.RegistrationNumber" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">CEO Name</label>
                                <input asp-for="Company.CEO_Name" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Employees</label>
                                <input asp-for="Company.EmployeeCount" type="number" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light fw-bold">Contact Details</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">City</label>
                            <input asp-for="Company.City" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Full Address</label>
                            <input asp-for="Company.Email" type="email" class="form-control" placeholder="Email" />
                        </div>
                        <div class="mb-3">
                            <input asp-for="Company.ContactPhone" class="form-control" placeholder="Phone Number" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white fw-bold">Financial Indicators ($)</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Assets Value</label>
                                <input asp-for="Company.AssetsValue" type="number" step="0.01" class="form-control" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Annual Turnover</label>
                                <input asp-for="Company.AnnualTurnover" type="number" step="0.01" class="form-control" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Net Profit</label>
                                <input asp-for="Company.NetProfit" type="number" step="0.01" class="form-control" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Proposed Rate (%)</label>
                                <input asp-for="Company.ProposedInterestRate" type="number" step="0.1" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-light fw-bold">Loan Details & Reports</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Min Amount Requested</label>
                                <input asp-for="Company.RequestedAmountMin" type="number" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Max Amount Requested</label>
                                <input asp-for="Company.RequestedAmountMax" type="number" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Status</label>
                                <select asp-for="Company.Status" class="form-select">
                                    <option value="Pending">Pending Review</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Financial Report Summary</label>
                            <textarea asp-for="Company.FinancialReportSummary" class="form-control" rows="4"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>