@page
@model LoanManagementSystem.Pages.Transactions.TransactionsListModel
@{
    ViewData["Title"] = "History of Transactions";
}

<div class="container-fluid shadow-sm p-4 bg-white rounded">
    <h2 class="mb-4">Transaction List</h2>

    <form method="get" class="row g-3 mb-4 align-items-end">
        <div class="col-md-3">
            <label class="form-label text-secondary small">Date From</label>
            <input type="date" asp-for="DateFrom" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label text-secondary small">Date To</label>
            <input type="date" asp-for="DateTo" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-search"></i> Search
            </button>
        </div>
        <div class="col-md-2">
            <a asp-page="/TransactionsList" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover border">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Loan No.</th>
                    <th>Date</th>
                    <th>Method</th>
                    <th class="text-end">Amount</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Transactions)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Customer</strong></td>
                        <td>#@item.LoanId</td>
                        <td>@item.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-light text-dark border">@item.Method</span></td>
                        <td class="text-end fw-bold">@item.Amount.ToString("N2") $</td>
                        <td class="small text-muted">@item.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>