@page "{loanId:int}"
@model LoanManagementSystem.Pages.Transactions.CreateModel
@{
    ViewData["Title"] = "New Payment";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Register Payment for Loan #@Model.LoanId</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="NewTransaction.LoanId" value="@Model.LoanId" />

                        <div class="mb-3">
                            <label class="form-label">Payment Amount ($)</label>
                            <input asp-for="NewTransaction.Amount" type="number" step="0.01" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Method</label>
                            <select asp-for="NewTransaction.PaymentMethod" class="form-select">
                                <option value="Card">Visa/Mastercard</option>
                                <option value="Cash">Cash at Branch</option>
                                <option value="BankTransfer">Bank Transfer (SWIFT)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Comment / Note</label>
                            <textarea asp-for="NewTransaction.Note" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/Loans/Index" class="btn btn-outline-secondary">Back</a>
                            <button type="submit" class="btn btn-success">Confirm Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>